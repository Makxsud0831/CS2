# cs2panel .env namunasi — bu faylni .env ga nusxalab, qiymatlarni to'ldiring.
# `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`

# --- Django asosiy ---
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=

# --- Steam ---
STEAM_API_KEY=

# --- FACEIT (yuqori levelga avtomatik VIP) ---
FACEIT_API_KEY=
FACEIT_VIP_LEVEL=10
FACEIT_VIP_DAYS=10
FACEIT_VIP_PLAN=vip

# --- Admin himoyasi ---
# Admin URL (default 'admin/'). Maxfiy qiymat qo'ying, masalan: my-secret-panel/
ADMIN_URL=admin/
RATELIMIT_ENABLE=True

# --- Server ---
SERVER_TICKRATE=128
SERVER_PUBLIC_IP=

# --- PostgreSQL (asosiy DB) ---
DB_NAME=cs_web
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- MySQL (WeaponPaints skin changer) ---
WP_DB_HOST=localhost
WP_DB_PORT=3306
WP_DB_USER=wp_user
WP_DB_PASSWORD=
WP_DB_NAME=weaponpaints
WP_SKINS_JSON=F:\cSERVER\game\csgo\addons\counterstrikesharp\plugins\WeaponPaints\data\skins_en.json

# --- RCON xavfsizlik (ixtiyoriy; default blocklist settings.py da) ---
# RCON_BLOCKED_COMMANDS=rcon_password,quit,exit,_restart,exec
# RCON_ALLOWED_COMMANDS=

# --- Server-bot endpoint IP cheklovi (checkpoint submit) ---
# Bo'sh = cheklov yo'q. O'yin server IP'sini qo'ying (bitta PC: 127.0.0.1,::1).
TRUSTED_SERVER_IPS=

# --- Production xavfsizlik (ixtiyoriy, DEBUG=False da avtomatik) ---
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
